.language-toggle
    display none
    position absolute
    right 0
    top 120px
    width 44px
    height 44px
    z-index 9
    -webkit-user-select none
    -moz-user-select none
    user-select none
    cursor pointer
    border none
    background none
    padding 0

    html.is-started &
        display block

    html.input-filter-menu &
    html.input-filter-cinematic &
    html.input-filter-intro &
        pointer-events none

    --hover-translate 4px

    html:not(.is-mode-touch) &:hover
        .button-inner
            transform translateX(-4px)

            &::after
                opacity 0.8

            .icon-container
                opacity 1

    .button-inner
        position absolute
        top 0
        left 0
        width calc(100% + var(--hover-translate))
        height 100%
        background radial-gradient(ellipse at top right, #C21515, #46123B)
        transition transform 0.15s 0.15s

        html.input-filter-menu &,
        html.input-filter-modal &,
        html.input-filter-intro &
        html.input-filter-cinematic &
            transform translateX(100%)
            transition-delay 0

        &::after
            content: ''
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            box-shadow 0 4px 10px rgba(0, 0, 0, 0.3)
            opacity 0.3
            transition opacity 0.3s
            pointer-events none

    .icon-container
        position absolute
        top 0
        left 0
        width 44px
        height 44px
        display flex
        justify-content center
        align-items center
        opacity 0.85
        transition opacity 0.3s

        .lang-text
            color #ffffff
            font-family 'Nunito', sans-serif
            font-size 14px
            font-weight 900
            letter-spacing 0.5px
